# Environment Variables Template
# Copy this file to backend/.env and fill in your actual credentials

# ========================================
# DATABASE CONFIGURATION
# ========================================
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ========================================
# AI SERVICES CONFIGURATION
# ========================================

# OPTION 1: Groq API Key (FREE tier available - Recommended)
# Get your key from: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# OPTION 2: OpenAI API Key (PAID - High Quality)
# Get your API key from: https://platform.openai.com/account/api-keys
# Costs: ~$0.01 per image, ~$0.006 per minute of audio
# OPENAI_API_KEY=sk-your-actual-openai-key-here

# OPTION 3: Free AI Services (NO COST - Good Quality)
# Leave OpenAI/Groq keys empty/commented to use free alternatives:
# - EasyOCR + BLIP for image analysis
# - Google Speech Recognition for audio transcription
# - Rule-based text enhancement

# ========================================
# SMS NOTIFICATIONS (TWILIO)
# ========================================
# Get these from your Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ========================================
# EMAIL CONFIGURATION (Optional - for future email integration)
# ========================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_email_password
# SMTP_FROM_EMAIL=noreply@tngrievance.gov.in

# ========================================
# SECURITY CONFIGURATION
# ========================================
# JWT_SECRET_KEY=your_jwt_secret_key_here
# ADMIN_API_KEY=your_admin_api_key_here

# ========================================
# APPLICATION SETTINGS
# ========================================
# DEBUG=False
# LOG_LEVEL=INFO
# MAX_UPLOAD_SIZE=10485760

# ========================================
# EXTERNAL SERVICES (Optional)
# ========================================
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# GEOCODING_API_KEY=your_geocoding_api_key

# ========================================
# NOTIFICATION SETTINGS
# ========================================
# NOTIFICATION_ENABLED=True
# SMS_ENABLED=True
# EMAIL_ENABLED=True

# ========================================
# REMINDERS CONFIGURATION
# ========================================
# REMINDER_SCHEDULE_HOURS=24
# MAX_REMINDERS_PER_DAY=100

# ========================================
# SETUP INSTRUCTIONS
# ========================================
# 1. Copy this file to backend/.env
# 2. Replace placeholder values with your actual credentials
# 3. Restart the application to load new environment variables
# 4. Test SMS functionality using /admin/test_sms endpoint
#
# For SMS setup help, see SMS_SETUP_GUIDE.md
# For MongoDB setup, see README.md
